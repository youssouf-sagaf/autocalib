# ── Autocalib — template staging (VM port 8001) ───────────────────────────
# Copier vers ~/autocalib/.env.staging sur la VM. Ne jamais committer.

# Mêmes clés que .env.example — valeurs souvent identiques sauf B2B/staff en test.

VITE_MAPBOX_TOKEN=
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_DATABASE_URL=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_ID=
VITE_MEASUREMENT_ID=
VITE_B2B_BASE_URL=https://backend-b2b.prod.cocoparks.io/api/v1

PREWARM_ML_MODELS=true

IMAGERY_PROVIDER=mapbox
IMAGERY_MAPBOX_ACCESS_TOKEN=

B2B_ENABLED=true
B2B_BASE_URL=https://backend-b2b.prod.cocoparks.io/api/v1
B2B_STAFF_UID=

COCOPARKS_PROD_URL=
COCOPARKS_PROD_VERIFY_SSL=false
